# Environment Variables for ADAMTOOL
# Copy this file to .env.local for local development (never commit .env.local)
# Set these as Cloudflare Pages environment variables in the dashboard

# ==============================
# Supabase (from supabase.com > Project Settings > API)
# ==============================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================
# Creator Auth (your email, used to grant creator access)
# ==============================
CREATOR_EMAIL=your_email@example.com
